		/// <summary>原地换数据（同一实例，选中态/信息浮层引用都不动，可视行经绑定即时重绘）</summary>
		public void Refresh(GameServerItem item)
		{
			Item = item;
			Name = item.ServerName;
			NameColor = item.HadSuccessfulResponse ? s_brightText : s_dimText;
			Game = string.IsNullOrEmpty(item.GameDescription) ? item.GameDir : item.GameDescription;
			PlayersText = item.PlayersText;
			Map = item.Map;

			// 原版历史记录列“最后运行日期”
			LastPlayed = item.TimeLastPlayed == 0
				? ""
				: DateTimeOffset.FromUnixTimeSeconds(item.TimeLastPlayed).LocalDateTime.ToString("yyyy-MM-dd HH:mm");

			// 原版 ServerBrowser_PendingPing "<暂挂>" / ServerBrowser_NotResponding "<没有响应>"
			Ping = item.HadSuccessfulResponse ? item.Ping.ToString() : "<暂挂>";
			PingColor = !item.HadSuccessfulResponse ? s_dimText
				: item.Ping < 100 ? s_green : item.Ping < 200 ? s_yellow : s_red;

			var f = "";
			if (item.Password) f += "密码 ";
			if (item.BotPlayers > 0) f += "机器人 ";
			if (item.Secure) f += "VAC";
			Flags = f.Trim();
		}

		void Set<T>(ref T field, T value, System.ComponentModel.PropertyChangedEventArgs args)
		{
			if (System.Collections.Generic.EqualityComparer<T>.Default.Equals(field, value))
				return;
			field = value;
			PropertyChanged?.Invoke(this, args);
		}
	}

