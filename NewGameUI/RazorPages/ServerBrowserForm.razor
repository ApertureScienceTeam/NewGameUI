	protected override void OnInitialized()
	{
		// 500ms 批量落一次：每次 Flush 都会触发一次整页渲染（Blazonia 行宿主的缺陷
		// 决定了渲染成本 ∝ 已实现行数），200ms 在 1600+ 行时明显卡顿
		_flushTimer = new DispatcherTimer(TimeSpan.FromMilliseconds(500), DispatcherPriority.Background, (_, _) => Flush());
		_flushTimer.Start();
		if (!SteamServers.Available)
		{
			_status = "无法获取主服务器地址。服务浏览器无法运行。";
			_emptyText = "Steam 未就绪（需通过 Steam 启动游戏）。";
			return;
		}
		Refresh();
	}

	public void Dispose()
	{
		_flushTimer?.Stop();
		_retryTimer?.Stop();
		StopAutoRetry();
		_query?.Dispose();
		_players?.Dispose();
		_rulesQuery?.Dispose();
	}

	// —— 原生列表接线（ServerListView 桥）——

	bool _wired;

	/// <summary>把原生 ListBox 和数据/事件接上。懒触发(首次 Flush/渲染时),不依赖 OnAfterRender 时序。
	/// ItemsSource 必须在这里显式挂——旧 razor 版由 Blazonia 代挂,改原生后断了这一根线。</summary>
	void EnsureWired()
	{
		if (_wired || _listView == null)
			return;
		_wired = true;
		var list = _listView.List;
		list.ItemsSource = _rows;
		list.ItemTemplate = BuildRowTemplate();
		list.SelectionChanged += (_, e) => OnRowSelectionChanged(e);
		list.DoubleTapped += OnRowDoubleTappedNative;
		list.PointerPressed += OnListPointerPressed;
		RebuildMenu();
	}

	protected override void OnAfterRender(bool firstRender) => EnsureWired();

	/// <summary>原生行模板:纯 FuncDataTemplate + 数据绑定,VirtualizingStackPanel 只实例化可视区。
	/// 列宽与表头共用 ColumnDefs;行高/悬停/选中样式复用 MainMenuWindow.axaml 的 ListBox.serverlist。</summary>
	IDataTemplate BuildRowTemplate()
	{
		return new FuncDataTemplate<ServerRow>((_, _) => BuildRowGrid(), supportsRecycling: false);
	}

	Avalonia.Controls.Grid BuildRowGrid()
	{
		var grid = new Avalonia.Controls.Grid { Margin = new Avalonia.Thickness(8, 0) };
		foreach (var def in Avalonia.Controls.ColumnDefinitions.Parse(ColumnDefs))
			grid.ColumnDefinitions.Add(new Avalonia.Controls.ColumnDefinition(def.Width));
		var col = 0;
		AddTextCell(grid, col++, nameof(ServerRow.Name), null);
		AddTextCell(grid, col++, nameof(ServerRow.Game), "#A9B7C6");
		AddTextCell(grid, col++, nameof(ServerRow.PlayersText), "#A9B7C6");
		AddTextCell(grid, col++, nameof(ServerRow.Map), "#A9B7C6");
		if (_tab == BrowserTab.History)
			AddTextCell(grid, col++, nameof(ServerRow.LastPlayed), "#A9B7C6");
		AddTextCell(grid, col++, nameof(ServerRow.Ping), null);
		AddTextCell(grid, col, nameof(ServerRow.Flags), "#8C9CAC", 11);
		return grid;
	}

	/// <summary>列单元格:文字必绑,colorPath 为空则固定色,否则绑定行上的颜色属性</summary>
	static void AddTextCell(Avalonia.Controls.Grid grid, int col, string path, string? color, double fontSize = 12)
	{
		var text = new Avalonia.Controls.TextBlock
		{
			FontSize = fontSize,
			VerticalAlignment = Avalonia.Layout.VerticalAlignment.Center,
			TextTrimming = Avalonia.Media.TextTrimming.CharacterEllipsis,
		};
		if (color != null)
			text.Foreground = Avalonia.Media.Brush.Parse(color);
		text.Bind(Avalonia.Controls.TextBlock.TextProperty, new Binding(path));
		if (color == null)
			text.Bind(Avalonia.Controls.TextBlock.ForegroundProperty, new Binding(path + "Color"));
		grid.Children.Add(text);
		Avalonia.Controls.Grid.SetColumn(text, col);
	}

	void OnRowDoubleTappedNative(object? sender, object e) => OnRowDoubleTapped();

	/// <summary>右键按下时选中指针下的行（原版列表行为:右键选中后才弹菜单）</summary>
	void OnListPointerPressed(object? sender, Avalonia.Input.PointerPressedEventArgs e)
	{
		var list = _listView?.List;
		if (list == null || !e.GetCurrentPoint(list).Properties.IsRightButtonPressed)
			return;
		if (e.Source is not Avalonia.Visual source)
			return;
		var container = source.GetSelfAndVisualAncestors()
			.OfType<Avalonia.Controls.ListBoxItem>().FirstOrDefault();
		if (container?.DataContext is not ServerRow row || ReferenceEquals(_selected, row))
			return;
		_suppressSelection = true;
		list.SelectedItem = row;
		_suppressSelection = false;
		_selected = row;
		RebuildMenu();
		StateHasChanged();
	}

