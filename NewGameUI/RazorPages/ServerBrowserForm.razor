@* 服务器浏览器：复刻原版 platform/servers/ServerBrowser.dll 的功能（页签布局沿用本项目 tab 样式）。
   布局来源：Servers/DialogServerBrowser.res（GameTabs + StatusLabel）、
   servers/InternetGamesPage.res（gamelist + Connect/RefreshAll/RefreshQuick/AddServer/AddCurrentServer
   + 调整过滤器 ToggleButton + FilterString）、servers/InternetGamesPage_Filters.res（Game/Map/Ping/Secure
   + Location 过滤器，以及“已经有玩家在游戏 / 服务器没有满 / 没有密码保护”复选框）、
   servers/DialogGameInfo.res（服务器信息：名称/游戏/IP地址/地图/玩家/延迟/VAC + 玩家列表 + 自动重试）、
   servers/DialogAddServer.res（添加服务器）、servers/DialogServerPassword.res（进入需要密码的服务器）。
   页签与顺序按 ServerBrowser.dll 的 AddPage：互联网 / 我喜爱的 / 历史记录 / 观看 / 局域网 / 朋友
   （#ServerBrowser_InternetTab / FavoritesTab / HistoryTab / SpectateTab / LanTab / FriendsTab）。
   列表用 Avalonia ListBox 承载(行高固定 24,样式见 MainMenuWindow.axaml 的 ListBox.serverlist)。
   性能:列表只绑显示窗口(默认 300 行,"显示更多"按需扩)——Blazonia 的行宿主对 Template 参数
   不做 diff、父组件每次渲染都会对所有已实现行重执行模板片段,且条目根只增不减
   (DataTemplateItemComponent/DataTemplateItemsComponent 反编译确认),1600+ 行直绑会越用越卡。
   全量数据(过滤/排序/上限 2000)都在 _all 上,状态栏计数显示全量。
   数据全部走 Steam 的 ISteamMatchmakingServers002（与 ServerBrowser.dll 同一条路径，
   见 Engine/Steam/SteamServers.cs），加入用 `connect ip:port`。 *@
@using System.Collections.ObjectModel
@using System.ComponentModel
@using Avalonia.Controls.Templates
@using Avalonia.Data
@using Avalonia.Threading
@using Avalonia.VisualTree
@using Plugin.Engine.Steam
@using Plugin.Views
@implements IDisposable

<Border Background="@("#161D26")" CornerRadius="12"
        BorderBrush="@("#2A3644")" BorderThickness="1"
        Padding="@("16,12")" Margin="20">
	<Panel>
		<Grid RowDefinitions="@("Auto,*,Auto")">

			@* —— 页签（原版 GameTabs / PropertySheet）—— *@
			<StackPanel Grid.Row="0" Orientation="Orientation.Horizontal" Spacing="4">
				@foreach (var tab in s_tabs)
				{
					<Button Width="104" Height="30" CornerRadius="6"
					        Background="@(tab == _tab ? "#26374A" : "#1B242F")"
					        Foreground="@(tab == _tab ? "#E9EFF5" : "#A9B7C6")"
					        OnClick="@(() => OnTabClick(tab))">@TabLabel(tab)</Button>
				}
			</StackPanel>

			@* —— 列表（原版 gamelist / ListPanel）：表头 + 虚拟化列表 —— *@
			<Border Grid.Row="1" Background="@("#0F151B")" CornerRadius="6" Margin="@("0,8,0,8")"
			        BorderBrush="@("#2A3644")" BorderThickness="1">
				<Grid RowDefinitions="@("Auto,*")">
					@* 表头：列头可点，原版 ListPanel::SetSortFunc（点同一列切换升降序）—— *@
					<Border Grid.Row="0" Background="@("#1B242F")" Padding="@("8,6")">
						<Grid ColumnDefinitions="@(ColumnDefs)">
							<Button Grid.Column="0" OnClick="@(() => SortBy(SortColumn.Name))" Height="22" Padding="@("0")"
							        FontSize="11" Background="@("Transparent")" HorizontalContentAlignment="HorizontalAlignment.Left"
							        Foreground="@SortColor(SortColumn.Name)">@SortLabel("服务器", SortColumn.Name)</Button>
							<Button Grid.Column="1" OnClick="@(() => SortBy(SortColumn.Game))" Height="22" Padding="@("0")"
							        FontSize="11" Background="@("Transparent")" HorizontalContentAlignment="HorizontalAlignment.Left"
							        Foreground="@SortColor(SortColumn.Game)">@SortLabel("游戏", SortColumn.Game)</Button>
							<Button Grid.Column="2" OnClick="@(() => SortBy(SortColumn.Players))" Height="22" Padding="@("0")"
							        FontSize="11" Background="@("Transparent")" HorizontalContentAlignment="HorizontalAlignment.Left"
							        Foreground="@SortColor(SortColumn.Players)">@SortLabel("玩家", SortColumn.Players)</Button>
							<Button Grid.Column="3" OnClick="@(() => SortBy(SortColumn.Map))" Height="22" Padding="@("0")"
							        FontSize="11" Background="@("Transparent")" HorizontalContentAlignment="HorizontalAlignment.Left"
							        Foreground="@SortColor(SortColumn.Map)">@SortLabel("地图", SortColumn.Map)</Button>
							@if (_tab == BrowserTab.History)
							{
								<Button Grid.Column="4" OnClick="@(() => SortBy(SortColumn.LastPlayed))" Height="22" Padding="@("0")"
								        FontSize="11" Background="@("Transparent")" HorizontalContentAlignment="HorizontalAlignment.Left"
								        Foreground="@SortColor(SortColumn.LastPlayed)">@SortLabel("最后运行日期", SortColumn.LastPlayed)</Button>
							}
							<Button Grid.Column="@(PingColumnIndex)" OnClick="@(() => SortBy(SortColumn.Ping))" Height="22" Padding="@("0")"
							        FontSize="11" Background="@("Transparent")" HorizontalContentAlignment="HorizontalAlignment.Left"
							        Foreground="@SortColor(SortColumn.Ping)">@SortLabel("延迟", SortColumn.Ping)</Button>
							<TextBlock Grid.Column="@(PingColumnIndex + 1)" Text="标记" FontSize="11" Foreground="@("#8C9CAC")"
							           VerticalAlignment="VerticalAlignment.Center" />
						</Grid>
					</Border>

					<Panel Grid.Row="1" Margin="@("0,2,0,0")">
						@* 列表 = 原生 Avalonia ListBox(ServerListView 桥):整棵列表在 Blazor 渲染树之外,
						   行模板是纯 FuncDataTemplate + 数据绑定(真虚拟化,只有可视区行存在),
						   父页面 StateHasChanged 完全不触达行控件。样式复用 MainMenuWindow.axaml
						   的 ListBox.serverlist(行高 24/悬停/选中),行模板/事件/右键菜单
						   在 OnAfterRender 与 RebuildMenu 里配置。 *@
						<ServerListView @ref="_listView" />

						@if (_all.Count > _rows.Count)
						{
							<Button OnClick="ShowMore" Width="230" Height="26" CornerRadius="6"
							        HorizontalAlignment="HorizontalAlignment.Center"
							        VerticalAlignment="VerticalAlignment.Bottom" Margin="@("0,0,0,4")"
							        Background="@("#263140")" Foreground="@("#DCE6EF")">显示更多(还有 @(_all.Count - _rows.Count) 条)</Button>
						}
						@if (_all.Count == 0)
						{
							<TextBlock Text="@_emptyText" Margin="@("10,12")" FontSize="12" Foreground="@("#8C9CAC")"
							           IsHitTestVisible="false" VerticalAlignment="VerticalAlignment.Top" />
						}
					</Panel>
				</Grid>
			</Border>

			@* —— 底部：过滤器展开区 + 按钮行 + 状态 —— *@
			<StackPanel Grid.Row="2" Spacing="6">

				@if (_filtersOpen)
				{
					<Border Background="@("#121A22")" CornerRadius="6" Padding="@("10,8")"
					        BorderBrush="@("#2A3644")" BorderThickness="1">
						<StackPanel Spacing="6">
							<StackPanel Orientation="Orientation.Horizontal" Spacing="8">
								<TextBlock Text="游戏" Width="44" FontSize="12" Foreground="@("#A9B7C6")"
								           VerticalAlignment="VerticalAlignment.Center" />
								<ComboBox T="string" ItemsSource="@s_gameOptions" Width="164"
								          SelectedIndex="@_gameFilterIndex" OnSelectionChanged="OnGameFilterChanged" />
								<TextBlock Text="区域" Width="72" FontSize="12" Foreground="@("#A9B7C6")"
								           VerticalAlignment="VerticalAlignment.Center" />
								<ComboBox T="string" ItemsSource="@s_regions" Width="112"
								          SelectedIndex="@_regionIndex" OnSelectionChanged="OnRegionChanged" />
								<CheckBox @bind-IsChecked="_filterNotEmpty">已经有玩家在游戏</CheckBox>
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="8">
								<TextBlock Text="地图" Width="44" FontSize="12" Foreground="@("#A9B7C6")"
								           VerticalAlignment="VerticalAlignment.Center" />
								<TextBox @bind-Text="_mapFilter" Width="164" />
								<TextBlock Text="延迟" Width="72" FontSize="12" Foreground="@("#A9B7C6")"
								           VerticalAlignment="VerticalAlignment.Center" />
								<ComboBox T="string" ItemsSource="@s_pingOptions" Width="112"
								          SelectedIndex="@_pingFilterIndex" OnSelectionChanged="OnPingFilterChanged" />
								<CheckBox @bind-IsChecked="_filterNotFull">服务器没有满</CheckBox>
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="8">
								<TextBlock Text="反作弊" Width="44" FontSize="12" Foreground="@("#A9B7C6")"
								           VerticalAlignment="VerticalAlignment.Center" />
								<ComboBox T="string" ItemsSource="@s_secureOptions" Width="164"
								          SelectedIndex="@_secureFilterIndex" OnSelectionChanged="OnSecureFilterChanged" />
								<CheckBox @bind-IsChecked="_filterNoPassword">没有密码保护</CheckBox>
							</StackPanel>
						</StackPanel>
					</Border>
				}

				<StackPanel Orientation="Orientation.Horizontal" Spacing="8">
					<Button OnClick="@(() => ToggleFilters())" Width="108" Height="28" CornerRadius="6"
					        Background="@("#263140")" Foreground="@("#DCE6EF")">调整过滤器</Button>
					<TextBlock Text="@_filterSummary" FontSize="11" Foreground="@("#7E8C9B")" Width="200"
					           VerticalAlignment="VerticalAlignment.Center" TextTrimming="TextTrimming.CharacterEllipsis" />
					<Button OnClick="@(() => QuickRefresh())" IsEnabled="@(_query != null)" Width="105" Height="28" CornerRadius="6"
					        Background="@("#263140")" Foreground="@("#DCE6EF")">快速刷新</Button>
					<Button OnClick="@(() => OnRefreshButton())" Width="95" Height="28" CornerRadius="6"
					        Background="@("#263140")" Foreground="@("#DCE6EF")">@(_refreshing ? "停止刷新" : "刷新全部")</Button>
					<Button OnClick="@(() => OpenAddServer())" Width="95" Height="28" CornerRadius="6"
					        Background="@("#263140")" Foreground="@("#DCE6EF")">添加服务器</Button>
					<Button OnClick="@(() => AddSelectedToFavorites())" IsEnabled="@(_selected != null)" Width="128" Height="28"
					        CornerRadius="6" Background="@("#263140")" Foreground="@("#DCE6EF")">添加当前服务器</Button>
					<Button OnClick="@(() => ConnectSelected())" IsEnabled="@(_selected != null)" Width="75" Height="28"
					        CornerRadius="6" Background="@("#4FA3E3")" Foreground="@("#0B1016")">连接</Button>
				</StackPanel>

				<TextBlock Text="@_status" FontSize="11" Foreground="@("#8C9CAC")" TextTrimming="TextTrimming.CharacterEllipsis" />
			</StackPanel>
		</Grid>

		@* —— 服务器信息模态（原版 CDialogGameInfo：Servers/DialogGameInfo.res）—— *@
		<Border Background="@("#B4000000")" IsVisible="@_infoOpen">
			<Border Background="@("#161D26")" BorderBrush="@("#2A3644")" BorderThickness="1" CornerRadius="8"
			        Width="560" Padding="@("18,14")" HorizontalAlignment="HorizontalAlignment.Center"
			        VerticalAlignment="VerticalAlignment.Center">
				<StackPanel Spacing="8">
					<TextBlock Text="游戏信息" FontSize="14" Foreground="@("#E9EFF5")" />

					<Grid ColumnDefinitions="@("88,*")" RowDefinitions="@("Auto,Auto,Auto,Auto,Auto,Auto")" RowSpacing="4">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" FontSize="12" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Row="0" Grid.Column="1" Text="@(_server?.Item.ServerName ?? "")" FontSize="12"
						           Foreground="@("#E9EFF5")" TextTrimming="TextTrimming.CharacterEllipsis" />
						<TextBlock Grid.Row="1" Grid.Column="0" Text="游戏：" FontSize="12" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Row="1" Grid.Column="1" Text="@(_server?.Game ?? "")" FontSize="12" Foreground="@("#DCE6EF")" />
						<TextBlock Grid.Row="2" Grid.Column="0" Text="IP地址：" FontSize="12" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Row="2" Grid.Column="1" Text="@(_server?.Item.Address ?? "")" FontSize="12"
						           Foreground="@("#DCE6EF")" />
						<TextBlock Grid.Row="3" Grid.Column="0" Text="地图：" FontSize="12" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Row="3" Grid.Column="1" Text="@(_server?.Item.Map ?? "")" FontSize="12"
						           Foreground="@("#DCE6EF")" />
						<TextBlock Grid.Row="4" Grid.Column="0" Text="玩家：" FontSize="12" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Row="4" Grid.Column="1" Text="@(_server?.Item.PlayersText ?? "")" FontSize="12"
						           Foreground="@("#DCE6EF")" />
						<TextBlock Grid.Row="5" Grid.Column="0" Text="延迟：" FontSize="12" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Row="5" Grid.Column="1" Text="@(_server?.Ping ?? "")" FontSize="12"
						           Foreground="@("#DCE6EF")" />
					</Grid>

					<Grid ColumnDefinitions="@("88,*")" RowDefinitions="@("Auto,Auto")" RowSpacing="4">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="Valve 反作弊：" FontSize="12" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Row="0" Grid.Column="1" Text="@(_server?.Item.Secure == true ? "安全" : "不安全")"
						           FontSize="12" Foreground="@(_server?.Item.Secure == true ? "#7FD68A" : "#D8C97A")" />
						<TextBlock Grid.Row="1" Grid.Column="0" Text="版本：" FontSize="12" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Row="1" Grid.Column="1" Text="@((_server?.Item.ServerVersion ?? 0).ToString())"
						           FontSize="12" Foreground="@("#DCE6EF")" />
					</Grid>

					@* 自动重试（DialogGameInfo_AutoRetry.res）：AutoRetry 开关 + 两个单选模式 *@
					<StackPanel Orientation="Orientation.Horizontal" Spacing="8">
						<CheckBox @bind-IsChecked="_autoRetry">自动重试</CheckBox>
						<TextBlock Text="（当此服务器有空余的玩家位置的时候）" FontSize="11" Foreground="@("#7E8C9B")"
						           VerticalAlignment="VerticalAlignment.Center" />
					</StackPanel>
					<StackPanel Spacing="2" Margin="@("4,0,0,0")">
						<RadioButton GroupName="retry" IsChecked="@(_retryModeIndex == 0)" IsEnabled="@(_autoRetry == true)"
						             OnClick="@(() => SetRetryMode(0))">服务器有可用的玩家位置的时候进入服务器。</RadioButton>
						<RadioButton GroupName="retry" IsChecked="@(_retryModeIndex == 1)" IsEnabled="@(_autoRetry == true)"
						             OnClick="@(() => SetRetryMode(1))">当服务器有可用的玩家位置的时候提醒我。</RadioButton>
					</StackPanel>

					@* 玩家列表（PlayerList）：玩家名字 / 比分 *@
					<Grid ColumnDefinitions="@("260,120")" Margin="@("8,4,0,0")">
						<TextBlock Grid.Column="0" Text="玩家名字" FontSize="11" Foreground="@("#8C9CAC")" />
						<TextBlock Grid.Column="1" Text="比分" FontSize="11" Foreground="@("#8C9CAC")" />
					</Grid>
					<Border Background="@("#0F151B")" CornerRadius="6" BorderBrush="@("#2A3644")" BorderThickness="1"
					        Height="140">
						<Panel>
							<ListBox T="PlayerRow" Classes="serverlist" ItemsSource="@_playerRows" Height="140">
								<ItemTemplate>
									<Grid ColumnDefinitions="@("260,120")" Margin="@("8,0")">
										<TextBlock Grid.Column="0" Text="@context.Name" FontSize="12"
										           Foreground="@("#DCE6EF")" VerticalAlignment="VerticalAlignment.Center"
										           TextTrimming="TextTrimming.CharacterEllipsis" />
										<TextBlock Grid.Column="1" Text="@context.Score" FontSize="12" Foreground="@("#A9B7C6")"
										           VerticalAlignment="VerticalAlignment.Center" />
									</Grid>
								</ItemTemplate>
							</ListBox>
							@if (_playerRows.Count == 0)
							{
								<TextBlock Text="此服务器当前没有玩家。" Margin="@("10,8")" FontSize="11" Foreground="@("#7E8C9B")"
								           IsHitTestVisible="false" VerticalAlignment="VerticalAlignment.Top" />
							}
						</Panel>
					</Border>

					@if (_showRules)
					{
						<TextBlock Text="服务器规则" FontSize="11" Foreground="@("#8C9CAC")" />
						<Border Background="@("#0F151B")" CornerRadius="6" BorderBrush="@("#2A3644")" BorderThickness="1"
						        Height="110">
							<ScrollViewer>
								<StackPanel Spacing="1" Margin="@("8,4")">
									@if (_ruleLines.Count == 0)
									{
										<TextBlock Text="正在读取服务器规则..." FontSize="11" Foreground="@("#7E8C9B")" />
									}
									@foreach (var line in _ruleLines)
									{
										<TextBlock Text="@line" FontSize="11" Foreground="@("#8C9CAC")" />
									}
								</StackPanel>
							</ScrollViewer>
						</Border>
					}

					<StackPanel Orientation="Orientation.Horizontal" Spacing="8"
					            HorizontalAlignment="HorizontalAlignment.Right">
						<Button OnClick="@(() => EnterFromInfo())" Width="80" Height="28" CornerRadius="6"
						        Background="@("#4FA3E3")" Foreground="@("#0B1016")">进入</Button>
						<Button OnClick="@(() => RefreshSelectedServer())" Width="80" Height="28" CornerRadius="6"
						        Background="@("#263140")" Foreground="@("#DCE6EF")">刷新</Button>
						<Button OnClick="@(() => ToggleRules())" Width="80" Height="28" CornerRadius="6"
						        Background="@("#263140")" Foreground="@("#DCE6EF")">@(_showRules ? "隐藏规则" : "规则")</Button>
						<Button OnClick="@(() => CloseServerInfo())" Width="80" Height="28" CornerRadius="6"
						        Background="@("#263140")" Foreground="@("#DCE6EF")">关闭</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		@* —— 服务器密码模态（原版 CDialogServerPassword：Servers/DialogServerPassword.res）—— *@
		<Border Background="@("#B4000000")" IsVisible="@_passwordPromptOpen">
			<Border Background="@("#161D26")" BorderBrush="@("#2A3644")" BorderThickness="1" CornerRadius="8"
			        Width="380" Padding="@("18,14")" HorizontalAlignment="HorizontalAlignment.Center"
			        VerticalAlignment="VerticalAlignment.Center">
				<StackPanel Spacing="10">
					<TextBlock Text="服务器需要密码才能进入" FontSize="14" Foreground="@("#E9EFF5")" />
					<TextBlock Text="这个服务器需要密码才能进入" FontSize="12" Foreground="@("#D8C97A")" />
					<StackPanel Orientation="Orientation.Horizontal" Spacing="8">
						<TextBlock Text="密码" Width="56" FontSize="12" Foreground="@("#A9B7C6")"
						           VerticalAlignment="VerticalAlignment.Center" />
						<TextBox @bind-Text="_password" Width="240" />
					</StackPanel>
					<StackPanel Orientation="Orientation.Horizontal" Spacing="8"
					            HorizontalAlignment="HorizontalAlignment.Right">
						<Button OnClick="@(() => ConfirmPasswordAndConnect())" Width="80" Height="28" CornerRadius="6"
						        Background="@("#4FA3E3")" Foreground="@("#0B1016")">连接</Button>
						<Button OnClick="@(() => CancelPasswordPrompt())" Width="80" Height="28" CornerRadius="6"
						        Background="@("#263140")" Foreground="@("#DCE6EF")">取消</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		@* —— 添加服务器模态（原版 CDialogAddServer：Servers/DialogAddServer.res）—— *@
		<Border Background="@("#B4000000")" IsVisible="@_addServerOpen">
			<Border Background="@("#161D26")" BorderBrush="@("#2A3644")" BorderThickness="1" CornerRadius="8"
			        Width="460" Padding="@("18,14")" HorizontalAlignment="HorizontalAlignment.Center"
			        VerticalAlignment="VerticalAlignment.Center">
				<StackPanel Spacing="10">
					<TextBlock Text="@(_addServerErrorTitle ?? "添加服务器 - 服务器")" FontSize="14" Foreground="@("#E9EFF5")" />
					<TextBlock Text="通过输入IP地址添加服务器。" FontSize="12" Foreground="@("#A9B7C6")" />
					<StackPanel Orientation="Orientation.Horizontal" Spacing="8">
						<TextBlock Text="IP地址：" Width="64" FontSize="12" Foreground="@("#A9B7C6")"
						           VerticalAlignment="VerticalAlignment.Center" />
						<TextBox @bind-Text="_addAddress" Width="280" />
					</StackPanel>
					<TextBlock Text="示例：tfc.valvesoftware.com，counterstrike.speakeasy.net:27016，205.158.143.200:27015"
					           FontSize="11" Foreground="@("#7E8C9B")" TextWrapping="TextWrapping.Wrap" />
					@if (_addServerError != null)
					{
						<TextBlock Text="@_addServerError" FontSize="11" Foreground="@("#E8746E")" />
					}
					<StackPanel Orientation="Orientation.Horizontal" Spacing="8"
					            HorizontalAlignment="HorizontalAlignment.Right">
						<Button OnClick="@(() => ConfirmAddServer())" Width="80" Height="28" CornerRadius="6"
						        Background="@("#4FA3E3")" Foreground="@("#0B1016")">确认</Button>
						<Button OnClick="@(() => CloseAddServer())" Width="80" Height="28" CornerRadius="6"
						        Background="@("#263140")" Foreground="@("#DCE6EF")">取消</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
	</Panel>
</Border>

@code {
	enum BrowserTab { Internet, Favorites, History, Spectate, Lan, Friends }

	// 列头排序（原版 ListPanel 的 SetSortFunc）
	enum SortColumn { Name, Game, Players, Map, LastPlayed, Ping }

	static readonly BrowserTab[] s_tabs =
		[BrowserTab.Internet, BrowserTab.Favorites, BrowserTab.History, BrowserTab.Spectate, BrowserTab.Lan, BrowserTab.Friends];

	// 过滤器文案与取值取自 serverbrowser_schinese.txt / Regions.vdf
	static readonly string[] s_gameOptions = ["<所有>", "Counter-Strike"];
	static readonly string[] s_pingOptions = ["<所有>", "< 50", "< 100", "< 150", "< 250", "< 350", "< 600"];
	static readonly int[] s_pingLimits = [0, 50, 100, 150, 250, 350, 600];
	static readonly string[] s_secureOptions = ["<所有>", "安全", "不安全"];

	// 区域过滤：platform/servers/Regions.vdf 的 code（255 = 全部，不传过滤器）
	static readonly string[] s_regions = ["世界", "美国 - 东部", "美国 - 西部", "南美", "欧洲", "亚洲", "澳大利亚", "中东", "非洲"];
	static readonly string[] s_regionCodes = ["255", "0", "1", "2", "3", "4", "5", "6", "7"];

	// 列表行:显示属性在构造/更新时预算好,并实现 INotifyPropertyChanged——
	// 行模板是原生 FuncDataTemplate + 数据绑定,快速刷新原地更新同一实例时可视行即时重绘
	sealed class ServerRow : System.ComponentModel.INotifyPropertyChanged
	{
		static readonly System.ComponentModel.PropertyChangedEventArgs
			s_nameArgs = new(nameof(Name)), s_nameColorArgs = new(nameof(NameColor)),
			s_gameArgs = new(nameof(Game)), s_playersTextArgs = new(nameof(PlayersText)),
			s_mapArgs = new(nameof(Map)), s_lastPlayedArgs = new(nameof(LastPlayed)),
			s_pingArgs = new(nameof(Ping)), s_pingColorArgs = new(nameof(PingColor)),
			s_flagsArgs = new(nameof(Flags));

		static readonly Avalonia.Media.IBrush
			s_brightText = Avalonia.Media.Brush.Parse("#DCE6EF"),
			s_dimText = Avalonia.Media.Brush.Parse("#6F7E8D"),
			s_green = Avalonia.Media.Brush.Parse("#7FD68A"),
			s_yellow = Avalonia.Media.Brush.Parse("#D8C97A"),
			s_red = Avalonia.Media.Brush.Parse("#E8746E");

		public event System.ComponentModel.PropertyChangedEventHandler? PropertyChanged;

		public GameServerItem Item { get; private set; }

		/// <summary>在 HServerListRequest 里的下标（RefreshServer / GetServerDetails 用）</summary>
