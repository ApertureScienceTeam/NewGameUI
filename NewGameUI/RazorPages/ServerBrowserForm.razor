	// —— 查询 ——

	void Refresh()
	{
		_query?.Dispose();
		_query = null;
		_all.Clear();
		_windowSize = WindowSize;
		_rows.Clear();
		_byAddress.Clear();
		// 列布局随页签变(History 多一列),行模板跟着重建
		if (_listView != null)
			_listView.List.ItemTemplate = BuildRowTemplate();
		_pending.Clear();
		_selected = null;
		_refreshing = false;
		_infoOpen = false;
		_showRules = false;
		_passwordPromptOpen = false;
		_pendingConnectAddress = null;
		RebuildMenu();

		if (!SteamServers.Available)
		{
			_status = "无法获取主服务器地址。服务浏览器无法运行。";
			_emptyText = "Steam 未就绪（需通过 Steam 启动游戏）。";
			StateHasChanged();
			return;
		}

		_query = _tab switch
		{
			// 区域在 Steam 端过滤（原版 InternetGamesPage 也是把 region 塞进过滤器请求）
			BrowserTab.Internet => SteamServers.RequestInternet(
				_regionIndex > 0 ? "region" : null,
				s_regionCodes[Math.Clamp(_regionIndex, 0, s_regionCodes.Length - 1)]),
			BrowserTab.Favorites => SteamServers.RequestFavorites(),
			BrowserTab.History => SteamServers.RequestHistory(),
			BrowserTab.Spectate => SteamServers.RequestSpectator(),
			BrowserTab.Lan => SteamServers.RequestLan(),
			BrowserTab.Friends => SteamServers.RequestFriends(),
			_ => null
		};

		if (_query == null)
		{
			_status = _tab == BrowserTab.Friends
				? "目前你的朋友中没有人在进行游戏。"
				: "无法获取主服务器地址。服务浏览器无法运行。";
			_emptyText = "";
			StateHasChanged();
			return;
		}

		_refreshing = true;
		_status = "刷新服务器列表...";
		_emptyText = "";
		_query.ServerResponded += OnServerResponded;
		_query.Completed += OnQueryCompleted;
		StateHasChanged();
	}

	// Steam 回调线程：这里立刻取详情（GetServerDetails 只在回调内有效），排队等 UI 线程刷新
	void OnServerResponded(int index)
	{
		var query = _query;
		var item = query?.GetServer(index);
		if (item == null)
			return;

		// 自动重试：这个服务器出现空位就直接进
		var retry = _autoRetryAddress;
		if (retry != null
			&& string.Equals(item.Address, retry, StringComparison.OrdinalIgnoreCase)
			&& item.MaxPlayers > 0
			&& item.Players < item.MaxPlayers)
		{
			Avalonia.Threading.Dispatcher.UIThread.Post(() =>
			{
				if (!string.Equals(_autoRetryAddress, retry, StringComparison.OrdinalIgnoreCase))
					return;
				StopAutoRetry();
				if (_retryModeIndex == 0)
				{
					_status = "服务器有空位，正在进入...";
					ConnectAddress(retry);
				}
				else
				{
					_status = "服务器有空位可以进入了。";
					StateHasChanged();
				}
			});
			return;
		}

		lock (_pending)
			_pending.Add((index, item));
	}

	void OnQueryCompleted()
	{
		Avalonia.Threading.Dispatcher.UIThread.Post(() =>
		{
			Flush();
			_refreshing = false;
			UpdateStatus();
			StateHasChanged();
		});
	}

	void Flush()
	{
		EnsureWired();
		bool changed = false;
		lock (_pending)
		{
			foreach (var (index, item) in _pending)
			{
				if (!PassesFilter(item))
					continue;
				if (_byAddress.TryGetValue(item.Address, out var exists))
				{
					// 快速刷新 / 单服刷新：原地更新同一行实例（选中态/信息浮层引用都不动），
					// 可视行经行模板的数据绑定即时重绘，不碰集合
					exists.Refresh(item);
					exists.Index = index;
					changed = true;
					continue;
				}
				if (_all.Count >= MaxRows)
					continue;
				var row = new ServerRow(item, index);
				_byAddress[item.Address] = row;
				var pos = InsertSorted(row);
				// 落进显示窗口才进 UI 集合（原生增量插入）；窗口外的等"显示更多"
				if (pos < _windowSize)
				{
					_rows.Insert(pos, row);
					if (_rows.Count > _windowSize)
						_rows.RemoveAt(_rows.Count - 1);
				}
				changed = true;
			}
			_pending.Clear();
		}
		if (changed)
		{
			UpdateStatus();
			StateHasChanged();
		}
	}

	/// <summary>按当前排序列二分插入到全量列表，返回落点下标（显示窗口的同步由 RebuildWindow 做）</summary>
	int InsertSorted(ServerRow row)
	{
		var lo = 0;
		var hi = _all.Count;
		while (lo < hi)
		{
			var mid = (lo + hi) / 2;
			if (CompareRows(_all[mid], row) <= 0)
				lo = mid + 1;
			else
				hi = mid;
		}
		_all.Insert(lo, row);
		return lo;
	}

	/// <summary>把 _all 的前 _windowSize 条同步到 _rows（一次集合 Reset；行实例保持不变，
	/// 选中态由 ListBox 按引用恢复）。只在窗口内容实际变化时调用</summary>
	void RebuildWindow()
	{
		_suppressSelection = true;
		_rows.Clear();
		var n = Math.Min(_windowSize, _all.Count);
		for (var i = 0; i < n; i++)
			_rows.Add(_all[i]);
		_suppressSelection = false;
	}

	/// <summary>"显示更多"：窗口再扩一批（增量 Add，不 Reset）</summary>
	void ShowMore()
	{
		var n = Math.Min(_all.Count, _windowSize + WindowSize);
		for (var i = _windowSize; i < n; i++)
			_rows.Add(_all[i]);
		_windowSize = Math.Max(_windowSize, n);
		StateHasChanged();
	}

	bool PassesFilter(GameServerItem item)
	{
		var limit = s_pingLimits[Math.Clamp(_pingFilterIndex, 0, s_pingLimits.Length - 1)];
		if (limit > 0 && (!item.HadSuccessfulResponse || item.Ping > limit))
			return false;
		if (_filterNotFull == true && item.MaxPlayers > 0 && item.Players >= item.MaxPlayers)
			return false;
		if (_filterNotEmpty == true && item.Players <= 0)
			return false;
		if (_filterNoPassword == true && item.Password)
			return false;
		if (_secureFilterIndex == 1 && !item.Secure)
			return false;
		if (_secureFilterIndex == 2 && item.Secure)
			return false;
		if (_gameFilterIndex == 1 && !string.Equals(item.GameDir, "cstrike", StringComparison.OrdinalIgnoreCase))
			return false;
		if (!string.IsNullOrEmpty(_mapFilter) && !item.Map.Contains(_mapFilter.Trim(), StringComparison.OrdinalIgnoreCase))
			return false;
		return true;
	}

	// 状态栏文案对齐 serverbrowser_schinese.txt（ServerBrowser_ServersCount = "服务器 (%s1)"）
	void UpdateStatus()
	{
		if (_refreshing)
			_status = $"刷新服务器列表... 服务器 ({_all.Count})";
		else if (_all.Count == 0)
			_status = _tab switch
			{
				BrowserTab.Lan => "在本地网络上没有运行任何服务器。",
				BrowserTab.Favorites => "你目前没有选择任何喜爱的服务器。",
				BrowserTab.History => "最近没有运行任何服务器。",
				BrowserTab.Friends => "目前你的朋友中没有人在进行游戏。",
				_ => "没有因特网游戏响应"
			};
		else
			_status = $"服务器 ({_all.Count})";

		_emptyText = _all.Count == 0 ? _status : "";
	}

	void OnRefreshButton()
	{
		if (_refreshing)
			StopRefresh();
		else
			Refresh();
	}

	/// <summary>停止刷新 = ISteamMatchmakingServers::CancelQuery，保留已收到的结果</summary>
	void StopRefresh()
	{
		_query?.Cancel();
		_refreshing = false;
		Flush();
		UpdateStatus();
		StateHasChanged();
	}

	/// <summary>快速刷新 = RefreshQuery：只重新 ping 已有列表，不重新请求主服务器</summary>
	void QuickRefresh()
	{
		if (_query == null)
		{
			Refresh();
			return;
		}
		_refreshing = true;
		_status = "刷新服务器列表...";
		_query.Refresh();
		StateHasChanged();
	}

	// —— 排序 ——

	SortColumn _sortColumn = SortColumn.Players;
	bool _sortAscending;

	void SortBy(SortColumn column)
	{
		if (_sortColumn == column)
			_sortAscending = !_sortAscending;
		else
		{
			_sortColumn = column;
			_sortAscending = true;
		}
		ApplySort();
		StateHasChanged();
	}

	/// <summary>排序比较（_sortAscending 决定升降序）</summary>
	int CompareRows(ServerRow a, ServerRow b)
	{
		var c = _sortColumn switch
		{
			SortColumn.Name => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase),
			SortColumn.Game => string.Compare(a.Game, b.Game, StringComparison.OrdinalIgnoreCase),
			SortColumn.Map => string.Compare(a.Map, b.Map, StringComparison.OrdinalIgnoreCase),
			SortColumn.LastPlayed => a.Item.TimeLastPlayed.CompareTo(b.Item.TimeLastPlayed),
			SortColumn.Ping => a.Item.Ping.CompareTo(b.Item.Ping),
			_ => a.Item.Players.CompareTo(b.Item.Players)
		};
		return _sortAscending ? c : -c;
	}

	void ApplySort()
	{
		_all.Sort(CompareRows);
		RebuildWindow();
		// 行实例全程保持，选中项引用仍然有效
	}

	string SortColor(SortColumn column) =>
		_sortColumn == column ? "#DCE6EF" : "#8C9CAC";

	string SortLabel(string text, SortColumn column) =>
		_sortColumn == column ? $"{text} {(_sortAscending ? "▲" : "▼")}" : text;

	// —— 交互 ——

	void OnRowSelectionChanged(Avalonia.Controls.SelectionChangedEventArgs e)
	{
		if (_suppressSelection)
			return;
		_selected = e.AddedItems.Count > 0 ? e.AddedItems[0] as ServerRow : null;
		RebuildMenu();
		// 原版只在打开服务器信息（DialogGameInfo）时才拉玩家列表
		if (_selected != null && _infoOpen)
			LoadPlayers(_selected.Item);
		StateHasChanged();
	}

	/// <summary>双击列表项 = 原版 ListPanel 的双击直接连接</summary>
	void OnRowDoubleTapped()
	{
		if (_selected != null)
			ConnectSelected();
	}

	/// <summary>拉玩家列表：DialogGameInfo 的 PlayerList（PlayersServer + AddPlayerToList）</summary>
	void LoadPlayers(GameServerItem item)
	{
		_players?.Dispose();
		_players = null;
		_playerRows.Clear();

		var query = SteamServers.RequestPlayers(item.Ip, item.ConnectionPort);
		if (query == null)
			return;
		_players = query;
		query.Changed += () => Avalonia.Threading.Dispatcher.UIThread.Post(() =>
		{
			if (!ReferenceEquals(_players, query))
				return;
			_playerRows.Clear();
			foreach (var (name, score) in query.Players.Take(64))
				_playerRows.Add(new PlayerRow(name, score));
			StateHasChanged();
		});
	}

	void ConnectSelected()
	{
		if (_selected == null)
			return;
		var item = _selected.Item;
		if (item.Password)
		{
			// 原版 DialogServerPassword：单独的密码模态
			_passwordPromptOpen = true;
			_pendingConnectAddress = item.Address;
			_status = "服务器需要密码才能进入。";
			StateHasChanged();
			return;
		}
		ConnectAddress(item.Address);
	}

	void ConfirmPasswordAndConnect()
	{
		if (!string.IsNullOrEmpty(_password))
			EngineCommands.SetCvar("password", _password);
		var address = _pendingConnectAddress ?? _selected?.Item.Address;
		_passwordPromptOpen = false;
		_password = "";
		_pendingConnectAddress = null;
		if (address != null)
			ConnectAddress(address);
		StateHasChanged();
	}

	void CancelPasswordPrompt()
	{
		_passwordPromptOpen = false;
		_password = "";
		_pendingConnectAddress = null;
		StateHasChanged();
	}

	/// <summary>原版连接链路：Q_snprintf("connect %s") → ClientCmd，同时写一条 Steam 历史记录</summary>
	void ConnectAddress(string address)
	{
		var item = _selected?.Item;
		if (item != null && SteamFavorites.TryParseAddress(item.Address, out var ip, out var port))
			SteamFavorites.Add(ip, port, item.QueryPort == 0 ? port : item.QueryPort, SteamFavorites.FlagHistory);

		// 满员：原版按 AutoRetry 的模式处理（JoinWhenSlotOpens / AlertMeWhenSlotOpens）
		if (item != null && item.MaxPlayers > 0 && item.Players >= item.MaxPlayers)
		{
			if (_autoRetry != true)
			{
				_status = "无法连接 - 服务器已经人满。";
				StateHasChanged();
				return;
			}
			StartAutoRetry(item.Address);
			_status = _retryModeIndex == 0
				? "当此服务器有空余的玩家位置的时候，你将会自动进入。"
				: "当此服务器有空余的玩家位置的时候，你将会被提醒。";
			StateHasChanged();
			return;
		}

		EngineCommands.ClientCmd($"connect {address}");
		// VAC：原版会对安全服务器提示 VAC_ConnectingToSecureServer，这里给一条状态提示
		if (item != null && item.Secure)
			_status = "注意：此服务器受 VAC 保护。作弊将导致永久性禁止。";
		else if (item != null)
			_status = "此服务器未启用 VAC，连接不受保护。";
		StateHasChanged();
	}

	void RefreshSelectedServer()
	{
		if (_selected == null || _query == null)
			return;
		SteamServers.RefreshServer(_query, _selected.Index);
		_status = "刷新服务器...";
		StateHasChanged();
	}

	/// <summary>添加当前服务器到收藏夹（原版 AddCurrentServer）</summary>
	void AddSelectedToFavorites()
	{
		if (_selected == null)
			return;
		var item = _selected.Item;
		if (!SteamFavorites.TryParseAddress(item.Address, out var ip, out var port))
			return;
		_status = SteamFavorites.Add(ip, port, item.QueryPort == 0 ? port : item.QueryPort, SteamFavorites.FlagFavorite)
			? $"已添加至收藏夹：{item.Address}"
			: "Steam 收藏不可用。";
		StateHasChanged();
	}

	/// <summary>删除我喜爱的服务器列表中的服务器</summary>
	void RemoveSelectedFromFavorites()
	{
		if (_selected == null)
			return;
		var item = _selected.Item;
		if (!SteamFavorites.TryParseAddress(item.Address, out var ip, out var port))
			return;
		var removed = SteamFavorites.Remove(ip, port, item.QueryPort == 0 ? port : item.QueryPort, SteamFavorites.FlagFavorite);
		_status = removed ? "已从收藏夹移除。" : "Steam 收藏不可用。";
		if (removed)
			Refresh();
		StateHasChanged();
	}

	/// <summary>从历史记录删除服务器</summary>
	void RemoveSelectedFromHistory()
	{
		if (_selected == null)
			return;
		var item = _selected.Item;
		if (!SteamFavorites.TryParseAddress(item.Address, out var ip, out var port))
			return;
		var removed = SteamFavorites.Remove(ip, port, item.QueryPort == 0 ? port : item.QueryPort, SteamFavorites.FlagHistory);
		_status = removed ? "已从历史记录移除。" : "Steam 收藏不可用。";
		if (removed)
			Refresh();
		StateHasChanged();
	}

	void OnRegionChanged(Avalonia.Controls.SelectionChangedEventArgs e)
	{
		var s = e.AddedItems.Count > 0 ? e.AddedItems[0]?.ToString() : null;
		var i = s == null ? -1 : Array.IndexOf(s_regions, s);
		if (i < 0 || i == _regionIndex)
			return;
		_regionIndex = i;
		// 区域是服务端过滤，必须重新请求列表
		Refresh();
	}

	void SetRetryMode(int index)
	{
		_retryModeIndex = index;
		StateHasChanged();
	}

	void ToggleRules()
	{
		if (_showRules)
		{
			_showRules = false;
			StateHasChanged();
			return;
		}
		LoadRules();
	}

	/// <summary>服务器规则：ISteamMatchmakingServers::RulesServer</summary>
	void LoadRules()
	{
		if (_selected == null)
			return;
		_rulesQuery?.Dispose();
		_ruleLines.Clear();
		_showRules = true;
		_rulesQuery = SteamServers.RequestRules(_selected.Item.Ip, _selected.Item.ConnectionPort);
		if (_rulesQuery == null)
		{
			_status = "Steam 接口不可用。";
			StateHasChanged();
			return;
		}
		var query = _rulesQuery;
		query.Changed += () => Avalonia.Threading.Dispatcher.UIThread.Post(() =>
		{
			if (!ReferenceEquals(_rulesQuery, query))
				return;
			_ruleLines.Clear();
			foreach (var (key, value) in query.Rules.Take(32))
				_ruleLines.Add($"{key} = {value}");
			if (query.Failed && _ruleLines.Count == 0)
				_ruleLines.Add("服务器没有响应。");
			StateHasChanged();
		});
		StateHasChanged();
	}

	// —— 自动重试轮询（每 5 秒刷一次该服务器，出现空位就进）——

	void StartAutoRetry(string address)
	{
		_autoRetryAddress = address;
		_retryTimer ??= new DispatcherTimer(TimeSpan.FromSeconds(5), DispatcherPriority.Background, (_, _) => RetryTick());
		_retryTimer.Start();
	}

	void StopAutoRetry()
	{
		_autoRetryAddress = null;
		_retryTimer?.Stop();
	}

	void RetryTick()
	{
		var address = _autoRetryAddress;
		if (address == null || _query == null)
		{
			StopAutoRetry();
			return;
		}
		if (!_byAddress.TryGetValue(address, out var row))
		{
			StopAutoRetry();
			return;
		}
		SteamServers.RefreshServer(_query, row.Index);
	}

