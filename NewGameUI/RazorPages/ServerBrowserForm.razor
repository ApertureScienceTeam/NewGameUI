	// 原来用固定像素（320,120,70,140,60,110 = 820），游戏内面板宽度小于这个总和时
	// 右边的列会被挤出可视区（延迟/标记看不到），所以改成星号比例，随窗口自适应。
	string ColumnDefs => _tab == BrowserTab.History
		? "2.5*,1.05*,0.55*,1.15*,0.95*,0.45*,0.8*"
		: "2.8*,1.2*,0.6*,1.4*,0.5*,0.8*";

