	/// <summary>过滤器变更：原版会重新点一次刷新（GetNewList），这里对已收到的结果重筛</summary>
	void ApplyFilterChange()
	{
		var kept = _all.Where(r => PassesFilter(r.Item)).ToList();
		_all.Clear();
		_all.AddRange(kept);
		RebuildWindow();
		if (_selected != null && !kept.Contains(_selected))
			_selected = null;
		UpdateStatus();
		StateHasChanged();
	}

	// 原版 FilterString：列出当前生效的过滤器（FilterDescLatency / NotFull / NotEmpty / NoPassword / SecureOnly / InsecureOnly）
	string _filterSummary
	{
		get
		{
			var parts = new List<string>();
			var limit = s_pingLimits[Math.Clamp(_pingFilterIndex, 0, s_pingLimits.Length - 1)];
			if (limit > 0)
				parts.Add($"延迟 < {limit}");
			if (_filterNotEmpty == true)
				parts.Add("未空");
			if (_filterNotFull == true)
				parts.Add("未满");
			if (_filterNoPassword == true)
				parts.Add("没有密码");
			if (_secureFilterIndex == 1)
				parts.Add("安全");
			else if (_secureFilterIndex == 2)
				parts.Add("不安全");
			if (!string.IsNullOrEmpty(_mapFilter))
				parts.Add($"地图 {_mapFilter}");
			return parts.Count == 0 ? "" : string.Join("、", parts);
		}
	}

	// —— 右键菜单 ——

	void RebuildMenu()
	{
		EnsureWired();
		_menuActions.Clear();
		var has = _selected != null;
		_menuActions.Add(new MenuAction("连接服务器", ConnectSelected, has));
		_menuActions.Add(new MenuAction("查看服务器信息", OpenServerInfo, has));
		_menuActions.Add(new MenuAction("刷新服务器", RefreshSelectedServer, has && _query != null));
		if (_tab != BrowserTab.Favorites)
			_menuActions.Add(new MenuAction("添加服务器到收藏夹", AddSelectedToFavorites, has));
		if (_tab == BrowserTab.Favorites)
			_menuActions.Add(new MenuAction("删除我喜爱的服务器列表中的服务器", RemoveSelectedFromFavorites, has));
		if (_tab == BrowserTab.History)
			_menuActions.Add(new MenuAction("从历史记录删除服务器", RemoveSelectedFromHistory, has));

		// 原生 ContextMenu(选中才挂;菜单项禁用态与原版一致)
		if (_listView == null)
			return;
		var menu = new Avalonia.Controls.ContextMenu();
		foreach (var action in _menuActions)
		{
			var captured = action;
			var item = new Avalonia.Controls.MenuItem
			{
				Header = captured.Header,
				IsEnabled = captured.Enabled,
			};
			item.Click += (_, _) => InvokeMenu(captured);
			menu.Items.Add(item);
		}
		_listView.List.ContextMenu = has ? menu : null;
	}

	void InvokeMenu(MenuAction action)
	{
		if (action.Enabled)
			action.Run();
	}
