	/// <summary>添加服务器（Servers/DialogAddServer.res）：成功后写进 Steam 收藏</summary>
	void ConfirmAddServer()
	{
		var addr = (_addAddress ?? "").Trim();
		if (addr.Length > 0 && !addr.Contains(':'))
			addr += ":27015";
		if (!SteamFavorites.TryParseAddress(addr, out var ip, out var port))
		{
			_addServerErrorTitle = "添加服务器 - 错误";
			_addServerError = "你所输入的服务器IP地址无效。";
			StateHasChanged();
			return;
		}
		var ok = SteamFavorites.Add(ip, port, port, SteamFavorites.FlagFavorite);
		if (!ok && !_localFavorites.Contains(addr))
			_localFavorites.Add(addr);
		_addServerOpen = false;
		_addAddress = "";
		_status = ok ? $"已添加至收藏夹：{addr}" : "Steam 收藏不可用，已临时记录到本次运行。";
		StateHasChanged();
	}

