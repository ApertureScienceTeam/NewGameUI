@* 游戏选项表单：逐页复刻原版 GameUI 选项对话框（GameUI.dll COptionsDialog + resource\OptionsSub*.res）。
   标签页顺序与原版 AddPage 一致（CS 1.6，liblist type=multiplayer_only）：
   多人游戏 / 音频 / 视频 / 瞄准(Aim) / 键盘 / 语音 / 内容(Content)。
   - 多人游戏（cstrike OptionsSubMultiplayer.res）：名字(name)、喷漆(cl_logofile/cl_logocolor)、
     准星(cl_crosshair_color 5 色/cl_crosshair_size/cl_crosshair_translucent)、
     高级…（cstrike/user.scr INFO_OPTIONS 全部 13 项）
   - 音频（OptionsSubAudio.res）：volume / MP3Volume / suitvolume / hisound 音质
   - 视频（OptionsSubVideo.res）：视频模式 / 窗口 / 宽屏(gl_widescreen_yfov) / 垂直同步 /
     纹理过滤(r_prefertexturefiltering) / 着色器(gl_use_shaders) / 亮度 / 伽马
   - 瞄准（OptionsSubMouse.res，原英文 Tab 名 Aim）：m_pitch / m_filter / sv_aim / m_rawinput /
     gl_lowlatency / sensitivity（原版复选框均带说明文字，此页一致）
   - 键盘（OptionsSubKeyboard.res + gfx/shell/kb_act.lst & kb_def.lst）：动作分组与顺序、默认键位
     按原版列表；双键槽对应原版 KEY/BUTTON 与 ALTERNATE 两列
   - 语音（OptionsSubVoice.res）：voice_modenable / voice_scale；发送音量与麦克风增益是
     引擎侧实现（无 cvar），仅提示
   - 内容（OptionsSubAdvanced.res，原 Tab 名 Content）：细节纹理(r_detailtextures) /
     原始模型(cl_himodels 反向) / 自定义附加内容(_setaddons_folder)
   全部 cvar/命令驱动；进入页面时读 cvar 与 config.cfg 保存值，底部"应用"统一下发 *@
<Border Background="@("#161D26")" CornerRadius="12"
        BorderBrush="@("#2A3644")" BorderThickness="1"
        Padding="@("20,12")" Margin="20">
	<Grid RowDefinitions="@("*,Auto")">
		<TabControl Grid.Row="0" T="TabItem" Margin="@("0,4,0,0")"
		            SelectedIndex="@_tabIndex" OnSelectionChanged="OnTabChanged">
			<TabItem Header="@("多人游戏")">
				<ScrollViewer>
					<StackPanel Spacing="12" Margin="@("16,16")">
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<TextBlock Text="玩家名字" Width="120" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<TextBox @bind-Text="_name" Width="300" MaxLength="63" />
							</StackPanel>

							@* 原版 cstrike 页隐藏了玩家模型/主副色（visible=0），CS 只显示喷漆与准星 *@
							<TextBlock Text="喷漆" FontWeight="FontWeight.SemiBold" Foreground="@("#E9EFF5")"
							           Margin="@("0,8,0,0")" />
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<TextBlock Text="喷漆图案" Width="120" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<ComboBox T="string" ItemsSource="@_logos" OnSelectionChanged="OnLogoSelected"
								          SelectedIndex="@_logoIndex" Width="260" MaxDropDownHeight="240"
								          VerticalAlignment="VerticalAlignment.Center" />
								@* 喷漆图案预览：读 logos/<名字>.bmp（调色板索引 255 透明） *@
								<Border Width="68" Height="68" Background="@("#0F151B")" CornerRadius="4" Padding="2">
									<Image Source="@_logoPreview" />
								</Border>
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<TextBlock Text="喷漆颜色" Width="120" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<ComboBox T="string" ItemsSource="@s_logoColorLabels" OnSelectionChanged="OnLogoColorSelected"
								          SelectedIndex="@_logoColorIndex" Width="180" />
							</StackPanel>
							<TextBlock Text="喷漆修改在加入服务器后生效" FontSize="11" Foreground="@("#8C9CAC")" />

							<TextBlock Text="准星外观" FontWeight="FontWeight.SemiBold" Foreground="@("#E9EFF5")"
							           Margin="@("0,8,0,0")" />
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<TextBlock Text="颜色" Width="120" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<ComboBox T="string" ItemsSource="@s_crosshairColorLabels" OnSelectionChanged="OnCrosshairColorSelected"
								          SelectedIndex="@_crosshairColorIndex" Width="180" />
								<TextBlock Text="大小" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<ComboBox T="string" ItemsSource="@s_crosshairSizeLabels" OnSelectionChanged="OnCrosshairSizeSelected"
								          SelectedIndex="@_crosshairSizeIndex" Width="120" />
								@* 准星预览：几何按 client.dll 的 HUD_DrawCrosshair 还原（4 根短条 + 中心间隙） *@
								<Grid Width="120" Height="120" Background="@("#0F151B")" Margin="@("16,0,0,0")"
								      ClipToBounds="true">
									@foreach (var bar in CrosshairBars)
									{
										<Border Background="@CrosshairColorText" Width="@bar.W" Height="@bar.H"
										        Margin="@bar.Offset"
										        HorizontalAlignment="HorizontalAlignment.Left"
										        VerticalAlignment="VerticalAlignment.Top" />
									}
								</Grid>
							</StackPanel>
							<CheckBox @bind-IsChecked="_crosshairTranslucent">半透明准星</CheckBox>

							@* 高级…：原版按钮打开 MultiplayerAdvancedDialog，条目来自 cstrike/user.scr INFO_OPTIONS *@
							<Expander Header="@("高级选项…")" Margin="@("0,8,0,0")">
								<StackPanel Spacing="10" Margin="@("8,12")">
									<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
										<TextBlock Text="尸体消失时间" Width="120" VerticalAlignment="VerticalAlignment.Center"
										           Foreground="@("#C6D2DD")" />
										<TextBox @bind-Text="_corpsestay" Width="100" />
										<TextBlock Text="秒（0 = 不消失）" FontSize="11" Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
									</StackPanel>
									<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
										<TextBlock Text="贴花上限" Width="120" VerticalAlignment="VerticalAlignment.Center"
										           Foreground="@("#C6D2DD")" />
										<TextBox @bind-Text="_mpDecals" Width="100" />
									</StackPanel>
									<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
										<TextBlock Text="最大弹壳数" Width="120" VerticalAlignment="VerticalAlignment.Center"
										           Foreground="@("#C6D2DD")" />
										<TextBox @bind-Text="_maxShells" Width="100" />
									</StackPanel>
									<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
										<TextBlock Text="最大烟雾粒子" Width="120" VerticalAlignment="VerticalAlignment.Center"
										           Foreground="@("#C6D2DD")" />
										<TextBox @bind-Text="_maxSmokePuffs" Width="100" />
									</StackPanel>
									<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
										<TextBlock Text="烟雾/毒气弹效果" Width="120" VerticalAlignment="VerticalAlignment.Center"
										           Foreground="@("#C6D2DD")" />
										<ComboBox T="string" ItemsSource="@s_fastSpritesLabels" OnSelectionChanged="@((Avalonia.Controls.SelectionChangedEventArgs e) => OnAdvListSelected("fastsprites", e))"
										          SelectedIndex="@_advListIndex["fastsprites"]" Width="180" />
									</StackPanel>
									<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
										<TextBlock Text="武器持向" Width="120" VerticalAlignment="VerticalAlignment.Center"
										           Foreground="@("#C6D2DD")" />
										<ComboBox T="string" ItemsSource="@s_handLabels" OnSelectionChanged="@((Avalonia.Controls.SelectionChangedEventArgs e) => OnAdvListSelected("cl_righthand", e))"
										          SelectedIndex="@_advListIndex["cl_righthand"]" Width="180" />
									</StackPanel>
									<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
										<TextBlock Text="购买菜单样式" Width="120" VerticalAlignment="VerticalAlignment.Center"
										           Foreground="@("#C6D2DD")" />
										<ComboBox T="string" ItemsSource="@s_buyMenuLabels" OnSelectionChanged="@((Avalonia.Controls.SelectionChangedEventArgs e) => OnAdvListSelected("_vgui_menus", e))"
										          SelectedIndex="@_advListIndex["_vgui_menus"]" Width="180" />
									</StackPanel>
									<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
										<TextBlock Text="雷达样式" Width="120" VerticalAlignment="VerticalAlignment.Center"
										           Foreground="@("#C6D2DD")" />
										<ComboBox T="string" ItemsSource="@s_radarLabels" OnSelectionChanged="@((Avalonia.Controls.SelectionChangedEventArgs e) => OnAdvListSelected("cl_radartype", e))"
										          SelectedIndex="@_advListIndex["cl_radartype"]" Width="180" />
									</StackPanel>
									<CheckBox @bind-IsChecked="_autoWeaponSwitch">自动换更强大的武器</CheckBox>
									<CheckBox @bind-IsChecked="_centerId">居中显示玩家名字</CheckBox>
									<CheckBox @bind-IsChecked="_autoHelp">自动帮助</CheckBox>
									<CheckBox @bind-IsChecked="_autoScreenshots">自动截图</CheckBox>
									<CheckBox @bind-IsChecked="_observerCrosshair">允许观察者准星</CheckBox>
								</StackPanel>
							</Expander>
						</StackPanel>
					</ScrollViewer>
				</TabItem>

			<TabItem Header="@("音频")">
				<ScrollViewer>
					<StackPanel Spacing="12" Margin="@("16,16")">
						<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
							<TextBlock Text="音效音量" Width="130" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
							<Slider Minimum="0" Maximum="1" Width="260" @bind-Value="_volume" />
							<TextBlock Text="@VolumeText" Width="40" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
						</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<TextBlock Text="MP3 音量" Width="130" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<Slider Minimum="0" Maximum="1" Width="260" @bind-Value="_mp3Volume" />
								<TextBlock Text="@Mp3VolumeText" Width="40" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<TextBlock Text="HEV 服音量" Width="130" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<Slider Minimum="0" Maximum="1" Width="260" @bind-Value="_suitVolume" />
								<TextBlock Text="@SuitVolumeText" Width="40" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
							</StackPanel>
						<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
							<TextBlock Text="音质" Width="130" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
							<ComboBox T="string" ItemsSource="@s_soundQualities" OnSelectionChanged="OnSoundQualitySelected"
							          SelectedIndex="@_soundQualityIndex" Width="180" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="@("视频")">
				<ScrollViewer>
					<StackPanel Spacing="12" Margin="@("16,16")">
						<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
							<TextBlock Text="渲染器" Width="110" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
							<TextBlock Text="OpenGL（本插件要求）" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#8C9CAC")" />
						</StackPanel>
						<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
							<TextBlock Text="分辨率" Width="110" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
							@* 用 SelectedItem 而不是 SelectedIndex：切换宽屏时新旧列表的选中下标可能相同，
							   Blazonia 对 SelectedIndex 是按缓存值跳过的，序号没变就不写控件，下拉会显示空白 *@
							<ComboBox T="string" ItemsSource="@_videoModeLabels" OnSelectionChanged="OnVideoModeSelected"
							          SelectedItem="@SelectedVideoModeLabel" Width="220" MaxDropDownHeight="300"
							          IsEnabled="@(_videoModeLabels.Length > 0)" />
						</StackPanel>
						<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
							<TextBlock Text="窗口模式" Width="110" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
							<CheckBox @bind-IsChecked="_windowed">窗口化</CheckBox>
						</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<TextBlock Text="宽屏视场" Width="110" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<CheckBox IsChecked="@_widescreenFov" IsCheckedChanged="OnWidescreenFovChanged">允许宽屏视场（FOV）</CheckBox>
							</StackPanel>
							<CheckBox @bind-IsChecked="_vsync">等待垂直同步</CheckBox>
							<CheckBox @bind-IsChecked="_textureFiltering">启用纹理过滤</CheckBox>
							<CheckBox @bind-IsChecked="_shaders">使用着色器</CheckBox>
							<TextBlock Text="分辨率列表按宽屏视场过滤：勾选显示 16:9，取消显示 4:3，切换时自动改选高度最接近的分辨率。应用视频模式时，画面可能短暂黑屏或重建。"
							           FontSize="11" Foreground="@("#8C9CAC")" TextWrapping="TextWrapping.Wrap" />
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12" Margin="@("0,8,0,0")">
								<TextBlock Text="亮度" Width="110" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<Slider Minimum="0" Maximum="2" Width="260" @bind-Value="_brightness" />
								<TextBlock Text="@BrightnessText" Width="40" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<TextBlock Text="暗 ↔ 亮" FontSize="11" Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
							</StackPanel>
						<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
							<TextBlock Text="伽马" Width="110" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
							<Slider Minimum="0.5" Maximum="3" Width="260" @bind-Value="_gamma" />
							<TextBlock Text="@GammaText" Width="40" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

				@* 原版 Tab 名为 Aim（gameui_english: GameUI_Mouse = "Aim"）；每个复选框右侧带说明文字 *@
				<TabItem Header="@("瞄准")">
					<ScrollViewer>
						<StackPanel Spacing="12" Margin="@("16,16")">
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<CheckBox @bind-IsChecked="_invertMouse" Width="140">反转鼠标</CheckBox>
								<TextBlock Text="反转鼠标上下轴" FontSize="11" Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<CheckBox @bind-IsChecked="_mouseFilter" Width="140">鼠标滤波</CheckBox>
								<TextBlock Text="平滑鼠标移动" FontSize="11" Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<CheckBox @bind-IsChecked="_autoAim" Width="140">自动瞄准</CheckBox>
								<TextBlock Text="瞄准时自动对准附近目标" FontSize="11" Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<CheckBox @bind-IsChecked="_rawInput" Width="140">原始鼠标输入</CheckBox>
								<TextBlock Text="直接读取鼠标数据" FontSize="11" Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<CheckBox @bind-IsChecked="_lowLatency" Width="140">降低输入延迟</CheckBox>
								<TextBlock Text="减少输入延迟" FontSize="11" Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
							</StackPanel>
							@* 原版灵敏度在页面底部：滑条 + 数字框 *@
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12" Margin="@("0,10,0,0")">
								<TextBlock Text="瞄准灵敏度" Width="130" VerticalAlignment="VerticalAlignment.Center"
								           Foreground="@("#C6D2DD")" />
								<Slider Minimum="0.1" Maximum="20" Width="260" @bind-Value="_sensitivity" />
								<TextBox Text="@SensitivityText" Width="56" IsReadOnly="true"
								         TextAlignment="TextAlignment.Right" />
							</StackPanel>
						</StackPanel>
					</ScrollViewer>
				</TabItem>

			<TabItem Header="@("键盘")">
				<ScrollViewer>
					<StackPanel Spacing="6" Margin="@("16,16")">
						<TextBlock Text="选择操作后按下新键；Backspace 清除，Esc 取消。"
						           FontSize="11" Foreground="@("#8C9CAC")" Margin="@("0,0,0,4")" />
						@foreach (var g in s_binds.GroupBy(b => b.Group))
						{
							<TextBlock Text="@g.Key" FontWeight="FontWeight.SemiBold"
							           Foreground="@("#E9EFF5")" Margin="@("0,10,0,2")" />
							@foreach (var b in g)
							{
								<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
									<TextBlock Text="@b.Label" Width="120" VerticalAlignment="VerticalAlignment.Center"
									           Foreground="@("#C6D2DD")" />
									<ContentControl Focusable="true" Classes="keycapture" Width="145"
									                OnPointerPressed="@((PointerPressedEventArgs e) => SlotPressed(b.Action, 0, e))"
									                OnPointerWheelChanged="@((PointerWheelEventArgs e) => SlotWheel(b.Action, 0, e))"
									                OnKeyDown="@((KeyEventArgs e) => SlotKeyDown(b.Action, 0, e))"
									                OnLostFocus="@((FocusChangedEventArgs e) => SlotLostFocus(b.Action, 0))">
										<Border Background="@(SlotBg(b.Action, 0))" BorderBrush="@(SlotBorder(b.Action, 0))"
										        BorderThickness="1" CornerRadius="6" Padding="@("8,5")">
											<TextBlock Text="@(SlotText(b.Action, 0))" Foreground="@(SlotColor(b.Action, 0))"
											           HorizontalAlignment="HorizontalAlignment.Center" />
										</Border>
									</ContentControl>
									<ContentControl Focusable="true" Classes="keycapture" Width="145"
									                OnPointerPressed="@((PointerPressedEventArgs e) => SlotPressed(b.Action, 1, e))"
									                OnPointerWheelChanged="@((PointerWheelEventArgs e) => SlotWheel(b.Action, 1, e))"
									                OnKeyDown="@((KeyEventArgs e) => SlotKeyDown(b.Action, 1, e))"
									                OnLostFocus="@((FocusChangedEventArgs e) => SlotLostFocus(b.Action, 1))">
										<Border Background="@(SlotBg(b.Action, 1))" BorderBrush="@(SlotBorder(b.Action, 1))"
										        BorderThickness="1" CornerRadius="6" Padding="@("8,5")">
											<TextBlock Text="@(SlotText(b.Action, 1))" Foreground="@(SlotColor(b.Action, 1))"
											           HorizontalAlignment="HorizontalAlignment.Center" />
										</Border>
									</ContentControl>
								</StackPanel>
							}
						}
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="@("语音")">
				<ScrollViewer>
					<StackPanel Spacing="12" Margin="@("16,16")">
						<CheckBox @bind-IsChecked="_voiceEnabled">启用游戏内语音</CheckBox>
						<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
							<TextBlock Text="麦克风音量" Width="130" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
							<Slider Minimum="0" Maximum="1" Value="0.5" Width="260" IsEnabled="false" />
						</StackPanel>
						<CheckBox IsEnabled="false">提升麦克风增益</CheckBox>
						<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
							<TextBlock Text="接收音量" Width="130" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
							<Slider Minimum="0" Maximum="1" Width="260" @bind-Value="_voiceReceive" />
							<TextBlock Text="@VoiceReceiveText" Width="40" VerticalAlignment="VerticalAlignment.Center"
							           Foreground="@("#C6D2DD")" />
						</StackPanel>
						<Button IsEnabled="false" Width="150" HorizontalAlignment="HorizontalAlignment.Left">测试麦克风</Button>
							<TextBlock Text="发送音量、麦克风增益和测试需要引擎语音设备接口；当前插件接口未开放这些控制。"
							           FontSize="11" Foreground="@("#8C9CAC")" TextWrapping="TextWrapping.Wrap" />
						</StackPanel>
					</ScrollViewer>
				</TabItem>

				@* 内容页（原 Tab 名 Content，OptionsSubAdvanced.res）：原始模型 / 插件内容 / 细节纹理 *@
				<TabItem Header="@("内容")">
					<ScrollViewer>
						<StackPanel Spacing="12" Margin="@("16,16")">
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<CheckBox @bind-IsChecked="_originalModels" Width="150">启用原始模型</CheckBox>
								<TextBlock Text="换回 1998 年发行时的低精度模型" FontSize="11" Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
							</StackPanel>
							<StackPanel Orientation="Orientation.Horizontal" Spacing="12">
								<CheckBox @bind-IsChecked="_addonsFolder" Width="150">允许自定义附加内容</CheckBox>
								<TextBlock Text="允许 addons 目录的自定义内容（重启后生效）" FontSize="11"
								           Foreground="@("#8C9CAC")" VerticalAlignment="VerticalAlignment.Center" />
							</StackPanel>
							<CheckBox @bind-IsChecked="_detailTextures">细节纹理</CheckBox>
							<TextBlock Text="部分内容设置需要重启游戏才能生效" FontSize="11" Foreground="@("#8C9CAC")" />
						</StackPanel>
					</ScrollViewer>
				</TabItem>
			</TabControl>

		<StackPanel Grid.Row="1" Orientation="Orientation.Horizontal"
		            HorizontalAlignment="HorizontalAlignment.Right" Margin="12">
			@* 恢复默认键位只对键盘页有意义，切到其它页时隐藏 *@
			<Button OnClick="RestoreDefaults" Width="120" Height="34" Margin="@("0,0,8,0")"
			        IsVisible="@(_tabIndex == s_keyboardTab)">恢复默认键位</Button>
			<Button OnClick="Apply" Width="110" Height="34"
			        Background="@("#4FA3E3")" Foreground="@("#0B1016")">应用</Button>
		</StackPanel>
	</Grid>
</Border>

@code {
    // 准星颜色（原版 5 色，值为 cl_crosshair_color 的 "r g b"）
