    void LoadBinds()
    {
        foreach (var b in s_binds)
        {
            var keys = SavedGameConfig.GetBinds(b.Action);
            _slot1[b.Action] = keys.Count > 0 ? keys[0] : "";
            _slot2[b.Action] = keys.Count > 1 ? keys[1] : "";
            _orig1[b.Action] = _slot1[b.Action];
            _orig2[b.Action] = _slot2[b.Action];
        }
    }

    bool IsCapturing(string action, int slot) => _captureAction == action && _captureSlot == slot;

    string SlotText(string action, int slot)
    {
        if (IsCapturing(action, slot))
            return "按下按键…";
        var key = (slot == 0 ? _slot1 : _slot2).GetValueOrDefault(action, "");
        return key.Length > 0 ? key : "未绑定";
    }

    string SlotColor(string action, int slot) =>
        IsCapturing(action, slot) ? "#6FBAF5" : "#E9EFF5";

    string SlotBg(string action, int slot) =>
        IsCapturing(action, slot) ? "#24405C" : "#263140";

    string SlotBorder(string action, int slot) =>
        IsCapturing(action, slot) ? "#4FA3E3" : "#2A3644";

    void SlotPressed(string action, int slot, PointerPressedEventArgs e)
    {
        if (IsCapturing(action, slot))
        {
            var props = e.GetCurrentPoint(null).Properties;
            SetSlot(action, slot, props.IsMiddleButtonPressed ? "mouse3"
                : props.IsRightButtonPressed ? "mouse2" : "mouse1");
            e.Handled = true;
        }
        else
        {
            _captureAction = action;
            _captureSlot = slot;
        }
    }

    void SlotWheel(string action, int slot, PointerWheelEventArgs e)
    {
        if (!IsCapturing(action, slot))
            return;
        SetSlot(action, slot, e.Delta.Y > 0 ? "mwheelup" : "mwheeldown");
        e.Handled = true;
    }

    void SlotKeyDown(string action, int slot, KeyEventArgs e)
    {
        if (!IsCapturing(action, slot))
            return;
        if (e.Key == Key.Escape)
            _captureAction = null;
        else if (e.Key == Key.Back)
            SetSlot(action, slot, "");
        else if (MapKeyName(e.Key) is { } name)
            SetSlot(action, slot, name);
        e.Handled = true;
    }

    void SlotLostFocus(string action, int slot)
    {
        if (IsCapturing(action, slot))
            _captureAction = null;
    }

    void SetSlot(string action, int slot, string key)
    {
        if (key.Length > 0)
        {
            foreach (var b in s_binds)
            {
                for (var index = 0; index < 2; index++)
                {
                    if (b.Action == action && index == slot)
                        continue;
                    var target = index == 0 ? _slot1 : _slot2;
                    if (string.Equals(target.GetValueOrDefault(b.Action, ""), key, StringComparison.OrdinalIgnoreCase))
                        target[b.Action] = "";
                }
            }
        }
        (slot == 0 ? _slot1 : _slot2)[action] = key;
        _captureAction = null;
    }

    static string? MapKeyName(Key key)
    {
        var name = key.ToString();
        switch (name)
        {
            case "Space": return "space";
            case "Enter": case "Return": return "enter";
            case "Tab": return "tab";
            case "LeftShift": case "RightShift": return "shift";
            case "LeftCtrl": case "RightCtrl": return "ctrl";
            case "LeftAlt": case "RightAlt": return "alt";
            case "Up": return "uparrow";
            case "Down": return "downarrow";
            case "Left": return "leftarrow";
            case "Right": return "rightarrow";
            case "Insert": return "ins";
            case "Delete": return "del";
            case "Home": return "home";
            case "End": return "end";
            case "PageUp": return "pgup";
            case "PageDown": return "pgdn";
            case "OemComma": return ",";
            case "OemPeriod": return ".";
            case "OemMinus": return "-";
            case "OemPlus": return "=";
            case "Oem1": return ";";
            case "Oem2": return "/";
            case "Oem3": return "`";
            case "Oem4": return "[";
            case "Oem5": return "\\";
            case "Oem6": return "]";
            case "Oem7": return "'";
        }
        if (name.Length == 1 && name[0] is >= 'A' and <= 'Z')
            return char.ToLowerInvariant(name[0]).ToString();
        if (name.Length == 2 && name[0] == 'D' && name[1] is >= '0' and <= '9')
            return name[1].ToString();
        if (name.Length >= 2 && name[0] == 'F' && int.TryParse(name.AsSpan(1), out var f) && f is >= 1 and <= 12)
            return "f" + f;
        return null;
    }

    void ApplyBinds()
    {
        foreach (var b in s_binds)
        {
            foreach (var (oldKey, newKey) in Pairs(b.Action))
            {
                if (oldKey.Length > 0 && !string.Equals(oldKey, newKey, StringComparison.OrdinalIgnoreCase))
                    EngineCommands.ClientCmd($"unbind \"{oldKey}\"");
            }
        }
        foreach (var b in s_binds)
        {
            foreach (var (oldKey, newKey) in Pairs(b.Action))
            {
                if (newKey.Length > 0 && !string.Equals(oldKey, newKey, StringComparison.OrdinalIgnoreCase))
                    EngineCommands.ClientCmd($"bind \"{newKey}\" \"{b.Action}\"");
            }
            _orig1[b.Action] = _slot1.GetValueOrDefault(b.Action, "");
            _orig2[b.Action] = _slot2.GetValueOrDefault(b.Action, "");
        }
    }

    IEnumerable<(string Old, string New)> Pairs(string action)
    {
        yield return (_orig1.GetValueOrDefault(action, ""), _slot1.GetValueOrDefault(action, ""));
        yield return (_orig2.GetValueOrDefault(action, ""), _slot2.GetValueOrDefault(action, ""));
    }

    void Apply()
    {
        var playerName = (_name ?? "").Trim().Replace("\"", "").Replace(";", " ");
        EngineCommands.SetCvar("name", playerName);
        EngineCommands.SetCvar("cl_crosshair_color", _crosshairColor);
        EngineCommands.SetCvar("cl_crosshair_size", _crosshairSize);
        EngineCommands.SetCvarFloat("cl_crosshair_translucent", _crosshairTranslucent == true ? 1 : 0);
        if (IsSafeGameToken(_selectedLogo))
            EngineCommands.SetCvar("cl_logofile", _selectedLogo);
        EngineCommands.SetCvar("cl_logocolor", s_logoColorTokens[Math.Clamp(_logoColorIndex, 0, s_logoColorTokens.Length - 1)]);

        // 高级选项（user.scr INFO_OPTIONS）
        EngineCommands.SetCvarFloat("cl_corpsestay", ParseNum(_corpsestay, 600));
        EngineCommands.SetCvarFloat("mp_decals", ParseNum(_mpDecals, 300));
        EngineCommands.SetCvarFloat("max_shells", ParseNum(_maxShells, 50));
        EngineCommands.SetCvarFloat("max_smokepuffs", ParseNum(_maxSmokePuffs, 20));
        EngineCommands.SetCvarFloat("fastsprites", ParseNum(s_fastSpritesValues[ListSel("fastsprites", s_fastSpritesValues.Length)], 1));
        EngineCommands.SetCvarFloat("cl_righthand", ParseNum(s_handValues[ListSel("cl_righthand", s_handValues.Length)], 1));
        var vguiMenus = s_buyMenuValues[ListSel("_vgui_menus", s_buyMenuValues.Length)];
        EngineCommands.SetCvarFloat("_vgui_menus", ParseNum(vguiMenus, 1));
        EngineCommands.ClientCmd($"setinfo _vgui_menus {vguiMenus}");   // user.scr 标记 SetInfo 的项同步上报
        EngineCommands.SetCvarFloat("_cl_autowepswitch", _autoWeaponSwitch == true ? 1 : 0);
        EngineCommands.SetCvarFloat("hud_centerid", _centerId == true ? 1 : 0);
        var autoHelp = _autoHelp == true ? 1 : 0;
        EngineCommands.SetCvarFloat("_ah", autoHelp);
        EngineCommands.ClientCmd($"setinfo _ah {autoHelp}");
        EngineCommands.SetCvarFloat("hud_takesshots", _autoScreenshots == true ? 1 : 0);
        EngineCommands.SetCvarFloat("cl_observercrosshair", _observerCrosshair == true ? 1 : 0);
        EngineCommands.SetCvarFloat("cl_radartype", ParseNum(s_radarValues[ListSel("cl_radartype", s_radarValues.Length)], 0));

        EngineCommands.SetCvarFloat("volume", (float)(_volume ?? 0.7));
        EngineCommands.SetCvarFloat("suitvolume", (float)(_suitVolume ?? 0.25));
        EngineCommands.SetCvarFloat("MP3Volume", (float)(_mp3Volume ?? 0.5));
        EngineCommands.SetCvarFloat("hisound", _soundQualityIndex == 0 ? 1 : 0);

        EngineCommands.SetCvarFloat("brightness", (float)(_brightness ?? 1));
        EngineCommands.SetCvarFloat("gamma", (float)(_gamma ?? 2.5));
        EngineCommands.SetCvarFloat("gl_vsync", _vsync == true ? 1 : 0);
        EngineCommands.SetCvarFloat("gl_widescreen_yfov", _widescreenFov == true ? 1 : 0);
        EngineCommands.SetCvarFloat("r_prefertexturefiltering", _textureFiltering == true ? 1 : 0);
        EngineCommands.SetCvarFloat("gl_use_shaders", _shaders == true ? 1 : 0);
        ApplyVideoMode();

        EngineCommands.SetCvarFloat("sensitivity", (float)(_sensitivity ?? 3));
        EngineCommands.SetCvarFloat("m_pitch", _invertMouse == true ? -_pitchMagnitude : _pitchMagnitude);
        EngineCommands.SetCvarFloat("m_filter", _mouseFilter == true ? 1 : 0);
        EngineCommands.SetCvarFloat("sv_aim", _autoAim == true ? 1 : 0);
        EngineCommands.SetCvarFloat("m_rawinput", _rawInput == true ? 1 : 0);
        EngineCommands.SetCvarFloat("gl_lowlatency", _lowLatency == true ? 1 : 0);

        EngineCommands.SetCvarFloat("voice_modenable", _voiceEnabled == true ? 1 : 0);
        EngineCommands.SetCvarFloat("voice_scale", (float)(_voiceReceive ?? 0.5));
        EngineCommands.SetCvarFloat("r_detailtextures", _detailTextures == true ? 1 : 0);
        if (_originalModels == true != _initialOriginalModels)
            EngineCommands.ClientCmd($"_sethdmodels {(_originalModels == true ? 0 : 1)}");
        if (_addonsFolder == true != _initialAddonsFolder)
            EngineCommands.ClientCmd($"_setaddons_folder {(_addonsFolder == true ? 1 : 0)}");

        ApplyBinds();
        EngineCommands.SaveSettings();
    }

    int ListSel(string cvar, int count) => Math.Clamp(_advListIndex.GetValueOrDefault(cvar, 0), 0, count - 1);

    void ApplyVideoMode()
    {
        if (_videoModeIndex < 0 || _videoModeIndex >= _videoModes.Length)
            return;
        if (_windowed is not { } windowed)
            return;

        var selected = _videoModes[_videoModeIndex];
        if (selected == _initialVideoMode && windowed == _initialWindowed)
            return;

        EngineCommands.ClientCmd($"_setvideomode {selected.Width} {selected.Height} {selected.BitsPerPixel}");
        EngineCommands.ClientCmd($"_setrenderer gl {(windowed ? "windowed" : "fullscreen")}");
        _initialVideoMode = selected;
        _initialWindowed = windowed;
    }

    void RestoreDefaults()
    {
        foreach (var b in s_binds)
        {
            foreach (var key in new[] { _orig1.GetValueOrDefault(b.Action, ""), _orig2.GetValueOrDefault(b.Action, "") })
            {
                if (key.Length > 0)
                    EngineCommands.ClientCmd($"unbind \"{key}\"");
            }
            var defaults = s_defaults.GetValueOrDefault(b.Action, []);
            _slot1[b.Action] = defaults.Length > 0 ? defaults[0] : "";
            _slot2[b.Action] = defaults.Length > 1 ? defaults[1] : "";
            _orig1[b.Action] = "";
            _orig2[b.Action] = "";
        }
        ApplyBinds();
        EngineCommands.SaveSettings();
    }
}
