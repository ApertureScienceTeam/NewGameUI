    // 分辨率列表跟随"宽屏视场"过滤：勾选只留 16:9，取消只留 4:3。1366x768 / 1360x768
    // 这类显示器原生尺寸与标准 16:9 差不到 1%，按同档处理；16:10、5:4 等其它比例两档都不算
    static bool MatchesAspect(VideoMode mode, bool widescreen) =>
        widescreen
            ? Math.Abs(mode.Width / (double)mode.Height - 16.0 / 9) < 0.02
            : Math.Abs(mode.Width / (double)mode.Height - 4.0 / 3) < 0.02;

    void RebuildVideoModeList()
    {
        // 基准：尚未"应用"的选择（没动过下拉时就是当前生效的分辨率）
        VideoMode? reference = _videoModes.Length > 0 && _videoModeIndex >= 0 && _videoModeIndex < _videoModes.Length
            ? _videoModes[_videoModeIndex]
            : _initialVideoMode;

        // 列表严格跟随勾选状态：勾选只留 16:9，取消只留 4:3
        var widescreen = _widescreenFov == true;
        _videoModes = _allVideoModes.Where(mode => MatchesAspect(mode, widescreen)).ToImmutableArray();
        _videoModeLabels = _videoModes.Select(mode => mode.Label).ToImmutableArray();

        if (_videoModes.Length == 0)
            _videoModeIndex = -1;   // 该比例一档都没有（实际不会发生）
        else if (reference is { } r)
            // 拿基准高度去新列表就近选：切换勾选必然换比例，基准必不在新列表，
            // 选中项因此总会跟着变；当前模式在同列表时宽度打平保证精确命中
            _videoModeIndex = NearestByHeight(_videoModes, r);
        else
            _videoModeIndex = 0;    // 读不到当前分辨率也选第一项，下拉不留空
    }

    // 按高度就近选档，高度打平时再比宽度：1920x1080 切 4:3 时 1280x960 与 1600x1200
    // 高度差同为 120，宽屏面板取 1600x1200 更合理
    static int NearestByHeight(IReadOnlyList<VideoMode> modes, VideoMode reference)
    {
        var best = -1;
        var bestHeightDiff = int.MaxValue;
        var bestWidthDiff = int.MaxValue;
        for (var i = 0; i < modes.Count; i++)
        {
            var heightDiff = Math.Abs(modes[i].Height - reference.Height);
            var widthDiff = Math.Abs(modes[i].Width - reference.Width);
            if (heightDiff < bestHeightDiff || (heightDiff == bestHeightDiff && widthDiff < bestWidthDiff))
            {
                best = i;
                bestHeightDiff = heightDiff;
                bestWidthDiff = widthDiff;
            }
        }
        return best;
    }

    static int FindIndex(IReadOnlyList<string> values, string value)
    {
        for (var i = 0; i < values.Count; i++)
        {
            if (string.Equals(values[i], value, StringComparison.OrdinalIgnoreCase))
                return i;
        }
        return 0;
    }

    static bool IsSafeGameToken(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && value.All(character => char.IsAsciiLetterOrDigit(character) || character is '_' or '-');

    static string NormalizeCrosshairSize(string size) => size switch
    {
        "0" => "auto",
        "1" => "small",
        "2" => "medium",
        "3" => "large",
        _ => size.ToLowerInvariant()
    };

    void LoadOptionLists()
    {
        try
        {
            var gameDir = EngineCommands.GetGameDirectory();
            if (gameDir == null)
                return;

            // 喷漆图案列表：mod 的 logos/ 优先，再并上 valve/logos（cstrike 目录里通常只有 remapped.bmp 调色板）
            _modLogosDir = Path.Combine(gameDir, "logos");
            var baseDir = Path.GetDirectoryName(gameDir);
            _valveLogosDir = baseDir == null ? null : Path.Combine(baseDir, "valve", "logos");
            _logos = ScanLogos();
            _selectedLogo = EngineCommands.GetCvarString("cl_logofile");
            if (IsSafeGameToken(_selectedLogo) && !_logos.Contains(_selectedLogo, StringComparer.OrdinalIgnoreCase))
                _logos = _logos.Add(_selectedLogo);
            _logoIndex = FindIndex(_logos, _selectedLogo);
            // 先取颜色再生成预览：预览是按颜色重映射后的图，顺序反了会用错色
            var logoColor = EngineCommands.GetCvarString("cl_logocolor", "#Valve_Orange");
            _logoColorIndex = FindIndex(s_logoColorTokens, logoColor);
            UpdateLogoPreview();

            var addonDir = Path.Combine(Path.GetDirectoryName(gameDir) ?? gameDir,
                Path.GetFileName(gameDir) + "_addon");
            _addonsFolder = Directory.Exists(addonDir);
            _initialAddonsFolder = _addonsFolder == true;
        }
        catch (Exception ex)
        {
            GoldSrcAvalonia.Log?.Invoke($"OptionsForm.LoadOptionLists failed: {ex}");
        }
    }

    ImmutableArray<string> ScanLogos()
    {
        var names = new List<string>();
        foreach (var dir in new[] { _modLogosDir, _valveLogosDir })
        {
            if (dir == null || !Directory.Exists(dir))
                continue;
            foreach (var file in Directory.GetFiles(dir, "*.bmp"))
            {
                var name = Path.GetFileNameWithoutExtension(file);
                // remapped.bmp 是喷漆用的调色板，不是图案
                if (name.Equals("remapped", StringComparison.OrdinalIgnoreCase) || !IsSafeGameToken(name))
                    continue;
                if (!names.Contains(name, StringComparer.OrdinalIgnoreCase))
                    names.Add(name);
            }
        }
        names.Sort(StringComparer.OrdinalIgnoreCase);
        return [.. names];
    }

    void UpdateLogoPreview()
    {
        _logoPreview = null;
        var name = _selectedLogo;
        if (string.IsNullOrEmpty(name) || !IsSafeGameToken(name))
            return;
        var (r, g, b) = s_logoColorValues[Math.Clamp(_logoColorIndex, 0, s_logoColorValues.Length - 1)];
        foreach (var dir in new[] { _modLogosDir, _valveLogosDir })
        {
            if (dir == null)
                continue;
            var bitmap = Plugin.Controls.GoldSrcLogo.LoadTinted(Path.Combine(dir, name + ".bmp"), r, g, b);
            if (bitmap != null)
            {
                _logoPreview = bitmap;
                return;
            }
        }
    }

    // —— 准星预览 ——
    // 逆向 client.dll（HUD_DrawCrosshair）得到：准星是 4 根 1px 细条，臂长与中心间隙按
    // screenW / 参考宽度 缩放；cl_crosshair_size 决定参考宽度（large 640 / medium 800 /
    // small 1024，auto 按当前分辨率取），cl_crosshair_translucent 决定 alpha（120 / 255），
    // cl_crosshair_color 是 "r g b"。这里按同一套比例画到 120x120 的画布上
    const int s_chCanvas = 120;
    const int s_chArmBase = 6;
    const int s_chGapBase = 3;

    sealed record CrosshairBar(double W, double H, Avalonia.Thickness Offset);

    // Blazonia 的 Background/Fill 参数是 OneOf<IBrush, Color, string>，直接给 "#AARRGGBB" 字符串
    string CrosshairColorText
    {
        get
        {
            var (r, g, b) = ParseCrosshairColor(_crosshairColor);
            var a = _crosshairTranslucent == true ? (byte)120 : (byte)255;
            return $"#{a:X2}{r:X2}{g:X2}{b:X2}";
        }
    }

    IReadOnlyList<CrosshairBar> CrosshairBars
    {
        get
        {
            var (screenW, _) = GoldSrcAvalonia.ScreenSize;
            if (screenW <= 0)
                screenW = 1024;

            var refW = _crosshairSize switch
            {
                "small" => 1024,
                "medium" => 800,
                "large" => 640,
                _ => screenW <= 640 ? 1024 : screenW >= 1024 ? 640 : 800
            };

            // 与游戏 1:1：引擎里就是 4 根 1px 的细条，臂长/间隙 = 基数 * screenW / 参考宽度（整数除法）。
            // 不能按画布把准星"放大到填满"，那样预览会比实际大，而且大/中/小会被归一成同一尺寸
            var arm = Math.Max(1, s_chArmBase * screenW / refW);
            var gap = Math.Max(1, s_chGapBase * screenW / refW);
            var c = s_chCanvas / 2;
            // 引擎的条一律 1px 粗，坐标取整，避免半像素被抗锯齿糊开
            return
            [
                new CrosshairBar(arm, 1, new Avalonia.Thickness(c - gap - arm, c, 0, 0)),
                new CrosshairBar(arm, 1, new Avalonia.Thickness(c + gap, c, 0, 0)),
                new CrosshairBar(1, arm, new Avalonia.Thickness(c, c - gap - arm, 0, 0)),
                new CrosshairBar(1, arm, new Avalonia.Thickness(c, c + gap, 0, 0))
            ];
        }
    }

    static (byte R, byte G, byte B) ParseCrosshairColor(string? value)
    {
        var parts = (value ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 3)
            return (50, 250, 50);

        static byte Component(string s)
            => byte.TryParse(s, out var v) ? (v > 255 ? (byte)255 : (byte)v) : (byte)0;

        return (Component(parts[0]), Component(parts[1]), Component(parts[2]));
    }

